{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,

    "noEmit": true,
    "declaration": true,
    "sourceMap": true,

    "baseUrl": ".",
    "paths": {
      "@kendihikayem/contract": ["packages/contract/src/index.ts"],
      "@kendihikayem/contract/*": ["packages/contract/src/*"],
      "@kendihikayem/mock": ["packages/mock/src/index.ts"],
      "@kendihikayem/mock/*": ["packages/mock/src/*"],
      "@kendihikayem/db": ["packages/db/src/index.ts"],
      "@kendihikayem/db/*": ["packages/db/src/*"],
      "@kendihikayem/ui": ["packages/ui/src/index.ts"],
      "@kendihikayem/ui/*": ["packages/ui/src/*"],
      "@kendihikayem/shared": ["packages/shared/src/index.ts"],
      "@kendihikayem/shared/*": ["packages/shared/src/*"],
      "@kendihikayem/config": ["packages/config/src/index.ts"],
      "@kendihikayem/config/*": ["packages/config/src/*"],
      "@kendihikayem/providers": ["packages/providers/src/index.ts"],
      "@kendihikayem/providers/*": ["packages/providers/src/*"],
      "@kendihikayem/media": ["packages/media/src/index.ts"],
      "@kendihikayem/media/*": ["packages/media/src/*"],
      "@kendihikayem/pdf": ["packages/pdf/src/index.ts"],
      "@kendihikayem/pdf/*": ["packages/pdf/src/*"],
      "@kendihikayem/safety": ["packages/safety/src/index.ts"],
      "@kendihikayem/safety/*": ["packages/safety/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".turbo", ".expo", "android", "ios"]
}
