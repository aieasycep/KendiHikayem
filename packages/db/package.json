{
  "name": "@kendihikayem/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, migrations and seeds",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "echo 'A0-DB: drizzle-kit migrate buraya baglanacak' && exit 0",
    "db:seed": "echo 'A0-DB: seed betigi buraya baglanacak' && exit 0"
  },
  "dependencies": {
    "@kendihikayem/config": "workspace:*",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10"
  }
}
