{
  "name": "@kendihikayem/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single, zod-validated source of environment configuration",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "3.25.76"
  }
}
