{
  "name": "@kendihikayem/contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zod + ts-rest API contract (single source of truth)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ts-rest/core": "3.52.1",
    "@ts-rest/open-api": "3.52.1",
    "zod": "3.25.76"
  }
}
