# Expo/React Native autolinking walks node_modules with plain fs and cannot follow
# pnpm's symlinked store layout. A hoisted node_modules is the only layout in which
# `expo prebuild` + Gradle autolinking resolves native modules correctly.
node-linker=hoisted

# Keep peer resolution loose: Expo's peer graph (react-native-web, react-server-dom-webpack,
# @testing-library/react-native) declares peers we deliberately do not install for a
# native-only app. Strict mode would fail the install on those.
strict-peer-dependencies=false
auto-install-peers=false

# Deterministic installs in CI.
resolution-mode=highest
save-exact=true
engine-strict=true
